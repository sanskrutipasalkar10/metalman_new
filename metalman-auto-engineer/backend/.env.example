# Copy this file to .env and fill in real values before deploying.
# Local dev works out of the box with just the defaults below (Ollama).

# --- Database ---
# Defaults to a local sqlite file if unset. For Docker/Oracle VM deployments,
# make sure this path is on a mounted volume so data survives restarts.
DATABASE_URL=sqlite:///./metalman.db

# --- Auth ---
# Falls back to a hardcoded dev value if unset - ALWAYS set a real random
# secret in production (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=change-me-to-a-random-secret

# --- Vision AI provider ---
# "ollama" (default, local dev) or "gemini" (for deployments where Ollama
# isn't reachable, e.g. the Oracle VM).
AI_PROVIDER=ollama

# Used when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_VISION_MODEL=gemma4:31b-cloud

# Used when AI_PROVIDER=gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
